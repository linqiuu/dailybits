generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                  @id @default(cuid())
  uid                     String?                 @unique
  email                   String?                 @unique
  name                    String?
  image                   String?
  departmentIds           String[]                @default([])
  banks                   QuestionBank[]
  knowledgeBanks          KnowledgeBank[]
  comments                Comment[]
  commentLikes            CommentLike[]
  subscribedSubscriptions Subscription[]          @relation("SubscribedBy")
  digestSubscriptions     DigestSubscription[]    @relation("DigestSubscribedBy")
  knowledgeSubscriptions  KnowledgeSubscription[] @relation("KnowledgeSubscribedBy")
}

enum Visibility {
  PRIVATE
  PUBLIC
  PARTIAL
}

enum SubscriptionScheduleMode {
  CUSTOM
  FIXED
}

enum SubscriptionCadence {
  DAILY
  WEEKLY
}

model QuestionBank {
  id                       String                   @id @default(cuid())
  title                    String
  description              String?
  creatorId                String
  subscriberCount          Int                      @default(0)
  visibility               Visibility               @default(PRIVATE)
  visibleDepartments       String[]                 @default([])
  visibleDepartmentNames   String[]                 @default([])
  subscriptionScheduleMode SubscriptionScheduleMode @default(CUSTOM)
  subscriptionCadence      SubscriptionCadence      @default(DAILY)
  subscriptionWeekdays     Int[]                    @default([])
  subscriptionPushTimes    String[]                 @default(["09:30", "14:00"])
  isOfficial               Boolean                  @default(false)
  externalSource           String?
  externalSlug             String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  creator                  User                     @relation(fields: [creatorId], references: [id])
  questions                Question[]
  subscriptions            Subscription[]
  answerEvents             QuestionAnswerEvent[]
  comments                 Comment[]

  @@unique([externalSource, externalSlug])
}

enum TargetType {
  USER
  GROUP
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
}

enum QuestionSource {
  MANUAL
  EXCEL_IMPORT
  AI_GENERATED
  LOCAL_SYNC
}

model Question {
  id                   String                @id @default(cuid())
  bankId               String
  content              String
  options              Json
  correctAnswer        String
  explanation          String
  status               QuestionStatus        @default(DRAFT)
  source               QuestionSource        @default(MANUAL)
  externalIdentityHash String?
  externalContentHash  String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  bank                 QuestionBank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  pushLogs             PushLog[]
  answerEvents         QuestionAnswerEvent[]

  @@unique([bankId, externalIdentityHash])
}

model KnowledgeBank {
  id                 String                  @id @default(cuid())
  title              String
  description        String?
  creatorId          String
  subscriberCount    Int                     @default(0)
  visibility         Visibility              @default(PRIVATE)
  visibleDepartments String[]                @default([])
  visibleDepartmentNames String[]            @default([])
  generationPrompt   String?                 @db.Text
  externalSource     String?
  externalSlug       String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  creator            User                    @relation(fields: [creatorId], references: [id])
  points             KnowledgePoint[]
  subscriptions      KnowledgeSubscription[]

  @@unique([externalSource, externalSlug])
}

model KnowledgePoint {
  id                   String             @id @default(cuid())
  bankId               String
  content              String             @db.Text
  orderIndex           Int
  externalIdentityHash String?
  externalContentHash  String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  bank                 KnowledgeBank      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  pushLogs             KnowledgePushLog[]

  @@unique([bankId, externalIdentityHash])
  @@index([bankId, orderIndex])
}

enum EndCondition {
  END_AFTER_COMPLETE
  REPEAT_N_TIMES
}

enum DigestType {
  GITHUB_TRENDING
  AI_NEWS
  ARXIV_AI_PAPERS
}

model Subscription {
  id           String       @id @default(cuid())
  targetType   TargetType   @default(USER)
  targetId     String
  bankId       String
  pushTimes    String[]     @default(["09:30", "14:00", "17:00"])
  isActive     Boolean      @default(true)
  endCondition EndCondition @default(END_AFTER_COMPLETE)
  repeatCount  Int          @default(0)
  currentCycle Int          @default(0)
  generation   Int          @default(0)
  subscriberId String?
  createdAt    DateTime     @default(now())
  bank         QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  subscriber   User?        @relation("SubscribedBy", fields: [subscriberId], references: [id])

  @@unique([targetType, targetId, bankId])
  @@index([targetType, targetId])
}

model DigestSubscription {
  id           String     @id @default(cuid())
  targetType   TargetType @default(USER)
  targetId     String
  digestType   DigestType
  pushTimes    String[]   @default(["09:00"])
  isActive     Boolean    @default(true)
  subscriberId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subscriber   User?      @relation("DigestSubscribedBy", fields: [subscriberId], references: [id])

  @@unique([targetType, targetId, digestType])
  @@index([targetType, targetId])
  @@index([digestType, isActive])
}

model KnowledgeSubscription {
  id           String             @id @default(cuid())
  targetType   TargetType         @default(USER)
  targetId     String
  bankId       String
  pushTimes    String[]           @default(["09:30", "14:00", "17:00"])
  isActive     Boolean            @default(true)
  subscriberId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  bank         KnowledgeBank      @relation(fields: [bankId], references: [id], onDelete: Cascade)
  subscriber   User?              @relation("KnowledgeSubscribedBy", fields: [subscriberId], references: [id])
  pushLogs     KnowledgePushLog[]

  @@unique([targetType, targetId, bankId])
  @@index([targetType, targetId])
}

model DigestCache {
  id         String     @id @default(cuid())
  digestType DigestType
  digestDate String
  items      Json
  fetchedAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([digestType, digestDate])
  @@index([digestDate])
}

model PushLog {
  id         String     @id @default(cuid())
  targetType TargetType @default(USER)
  targetId   String
  questionId String
  subscriptionId String?
  cycle      Int        @default(0)
  generation Int        @default(0)
  deliveryJobId String? @unique
  pushedAt   DateTime   @default(now())
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, questionId])
  @@index([targetType, targetId])
  @@index([subscriptionId, generation, cycle])
}

enum DeliveryKind {
  QUESTION
  KNOWLEDGE
  DIGEST
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  ACCEPTED
  FAILED
  CANCELLED
  UNKNOWN
}

model DeliveryJob {
  id                String         @id @default(cuid())
  dedupeKey         String         @unique
  kind              DeliveryKind
  subscriptionId    String
  targetType        TargetType
  targetId          String
  scheduleDate      String
  pushTime          String
  scheduledAt       DateTime
  expiresAt         DateTime
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  lockedAt          DateTime?
  lockToken         String?
  payload           Json?
  receipt           Json?
  externalMessageId String?
  lastErrorCode     String?
  acceptedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([targetType, targetId, scheduledAt])
  @@index([kind, scheduledAt])
}

model SchedulerState {
  id         String   @id
  lastTickAt DateTime
  lastErrorCode String?
  cursor     String?
  updatedAt  DateTime @updatedAt
}

model QuestionAnswerEvent {
  id             String       @id @default(cuid())
  cardId         String
  receiver       String
  respondentId   String
  questionId     String
  bankId         String
  selectedAnswer String
  correctAnswer  String
  isCorrect      Boolean
  answeredAt     DateTime
  sourceSystem   String       @default("card-service")
  createdAt      DateTime     @default(now())
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  bank           QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([cardId, respondentId])
  @@index([bankId, answeredAt])
  @@index([questionId, answeredAt])
  @@index([respondentId, answeredAt])
}

model DigestPushLog {
  id         String     @id @default(cuid())
  targetType TargetType @default(USER)
  targetId   String
  digestType DigestType
  digestDate String
  pushTime   String     @default("09:00")
  pushedAt   DateTime   @default(now())

  @@unique([targetType, targetId, digestType, digestDate, pushTime])
  @@index([targetType, targetId])
  @@index([digestType, digestDate])
}

model KnowledgePushLog {
  id               String                @id @default(cuid())
  subscriptionId   String
  targetType       TargetType            @default(USER)
  targetId         String
  bankId           String
  knowledgePointId String
  contentSnapshot  String                @db.Text
  pushDate         String
  pushTime         String
  pushedAt         DateTime              @default(now())
  subscription     KnowledgeSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  knowledgePoint   KnowledgePoint        @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, pushDate, pushTime])
  @@index([targetType, targetId])
  @@index([bankId, pushedAt])
}

model Comment {
  id        String        @id @default(cuid())
  content   String
  bankId    String
  userId    String
  parentId  String?
  likeCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  bank      QuestionBank  @relation(fields: [bankId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([bankId, createdAt])
  @@index([bankId, likeCount])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}
