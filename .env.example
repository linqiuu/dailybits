# === 数据库 ===
DATABASE_URL="postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres"
POSTGRES_DB="dailybits"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
DOCKER_DATABASE_URL=""
APP_BIND_IP="127.0.0.1"
APP_PORT="3000"

# === 认证 ===
AUTH_MODE="dev"
DEV_USER_ID="local-admin"
DEV_USER_UID="local-admin"
DEV_USER_NAME="Local Admin"
DEV_USER_EMAIL="local-admin@example.test"
DEV_USER_DEPARTMENT="本地开发"
ADMIN_USER_IDS="local-admin"

# === LLM ===
LLM_PROVIDER="openai"
LLM_API_KEY=""
LLM_API_BASE_URL=""
LLM_MODEL="gpt-4o-mini"
LLM_TIMEOUT_MS="120000"

# === 推送 ===
PUSH_PROVIDER="generic"
PUSH_MOCK="false"
PUSH_TIMEOUT_MS="15000"
PUSH_API_URL=""
INNER_API_BASE_URL="http://127.0.0.1:4010"
INNER_API_KEY=""
INNER_API_KEY_HEADER="X-Inner-API-Key"
MESSAGING_API_BASE_URL=""
MESSAGING_INNER_API_KEY=""
MESSAGING_INNER_API_KEY_HEADER=""
MESSAGING_CARD_SEND_PATH="/messaging/v1/cards/send"
MESSAGING_TIMEOUT_MS="15000"
MESSAGING_RETRY_ATTEMPTS="3"
MESSAGING_RETRY_BASE_MS="1000"
MESSAGING_MAX_RETRY_DELAY_MS="30000"
CARD_SERVICE_API_BASE=""
CARD_SERVICE_SEND_API_KEY=""
CARD_SERVICE_SEND_API_KEY_HEADER="X-Card-Service-Key"
CARD_SERVICE_QA_PATH="/send/qa"
CARD_SERVICE_QA_ANSWER_CALLBACK_URL=""
CARD_SERVICE_EVENT_SECRET=""
CARD_SERVICE_EVENT_SECRET_HEADER="X-Card-Event-Secret"

# === Jina Reader ===
JINA_API_KEY=""

# === 交流群 ===
GROUP_CHAT_ID=""

# === 部门查询 ===
DIRECTORY_API_BASE_URL="http://127.0.0.1:4010"
DIRECTORY_INNER_API_KEY=""
DIRECTORY_INNER_API_KEY_HEADER="X-Inner-API-Key"
DEPARTMENT_API_URL=""

# === 调度器 ===
SCHEDULER_TIMEZONE="Asia/Shanghai"
HOLIDAY_COUNTRY="CN"
SKIP_NON_WORKING_DAYS="true"
SCHEDULER_CATCH_UP_MINUTES="360"
SCHEDULER_BATCH_SIZE="50"

# === Local question bank sync ===
QUESTION_SYNC_OWNER_UID=""

# === Daily digest subscriptions ===
DIGEST_ITEM_LIMIT="12"
DIGEST_FETCH_FAILURE_COOLDOWN_MINUTES="180"
GITHUB_TOKEN=""
GITHUB_TRENDING_LANGUAGE=""
GITHUB_TRENDING_SEARCH_QUERY=""
GITHUB_README_SUMMARY_MAX_CHARS="5000"
GITHUB_README_SUMMARY_CONCURRENCY="2"
DIGEST_AI_CONCURRENCY="3"
AI_NEWS_PROVIDER="aihot"
AIHOT_API_BASE_URL="https://aihot.virxact.com"
AIHOT_DIGEST_MODE="daily"
AIHOT_DAILY_READY_TIME="08:10"
AIHOT_ITEMS_WINDOW="24h"
AIHOT_ITEMS_BY="timeline"
AIHOT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124 Safari/537.36"
AI_NEWS_TRANSLATION_MAX_CHARS="1800"
ARXIV_TRANSLATION_MAX_CHARS="3500"
AI_NEWS_RSS_FEEDS="https://aihot.virxact.com/feed.xml,https://openai.com/news/rss.xml,https://news.mit.edu/rss/topic/artificial-intelligence2"
AI_NEWS_HN_QUERY="artificial intelligence"
ARXIV_AI_CATEGORIES="cs.AI,cs.LG,cs.CL,cs.CV,stat.ML"
ARXIV_AI_SEARCH_QUERY=""
ARXIV_FETCH_ATTEMPTS="2"
ARXIV_RETRY_BASE_MS="15000"
